# soft-float objects.  The whole image is built from source, so the switch is
# self-consistent; LVGL's native Helium asm uses integer MVE only.
CONFIG_ARCH_FPU=y
# CONFIG_ARM_FPU_ABI_SOFT is not set
CONFIG_ARM_FPU_ABI_HARD=y
