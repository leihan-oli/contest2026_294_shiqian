# Interrupt stack: the ATON epoch handling runs in interrupt context and is
# deep (software fallback float layers, epoch bookkeeping, ISR-side logging).
# 8KB was measured at 98% usage (8032/8192) right before a HardFault.
CONFIG_ARCH_INTERRUPTSTACK=16384
CONFIG_ARCH_IRQPRIO=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARM_MPU=y

# Cortex-M fault decoding.  Without these the fault handlers go straight to the
# panic path without printing CFSR/HFSR/MMFSR/BFSR/UFSR or the fault address,
# so a crash only tells us "Assertion failed panic: arm_hardfault.c:186".
# With them the log names the fault class, the address (BFAR/MMFAR) and the
# faulting frame (the handlers print the hardware exception frame).
CONFIG_DEBUG_HARDFAULT_ALERT=y
CONFIG_DEBUG_MEMFAULT=y
CONFIG_DEBUG_BUSFAULT=y
CONFIG_DEBUG_USAGEFAULT=y
# Cortex-M55 caches: the D-Cache is enabled at boot (stm32n6_start.c);
# the camera and SDMMC paths disable it explicitly while they own the
# fabric.  ATON cache maintenance (mcu_cache_*) maps onto these ops.
