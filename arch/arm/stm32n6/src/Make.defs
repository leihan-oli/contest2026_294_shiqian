include armv8-m/Make.defs

CHIP_CSRCS  = stm32n6_start.c stm32n6_rcc.c stm32n6_lowputc.c
CHIP_CSRCS += stm32n6_serial.c stm32n6_irq.c
CHIP_CSRCS += stm32n6_gpio.c stm32n6_timerisr.c stm32n6_pwr.c
CHIP_CSRCS += stm32n6_idle.c

ifeq ($(CONFIG_VIDEO),y)
  CHIP_CSRCS += stm32n6_dcmipp.c
endif

ifeq ($(CONFIG_STM32_IMX335),y)
  CHIP_CSRCS += stm32n6_imx335.c
endif

ifeq ($(CONFIG_STM32_GT9XXX),y)
  CHIP_CSRCS += stm32n6_gt9xxx.c
ifeq ($(CONFIG_STM32N6_GT9XXX_INPUT),y)
  CHIP_CSRCS += stm32n6_gt9xxx_input.c
endif
endif

ifeq ($(CONFIG_STM32N6_LCD),y)
  CHIP_CSRCS += stm32n6_lcd.c
endif

ifeq ($(CONFIG_STM32_DCMIPP),y)
  CHIP_CSRCS += stm32n6_dcmipp.c
endif

ifeq ($(CONFIG_STM32N6_VIDEO),y)
  CHIP_CSRCS += stm32n6_video.c
endif

ifeq ($(CONFIG_STM32N6_ATON_AIE),y)
  CHIP_CSRCS += stm32n6_aton_aie.c
endif

ifeq ($(CONFIG_LIB_AI_ATON),y)
  CHIP_CSRCS += stm32n6_cacheaxi.c
endif

ifeq ($(CONFIG_VIDEO_FB),y)
  CHIP_CSRCS += stm32n6_ltdc.c
endif

ifeq ($(CONFIG_STM32_IWDG),y)
  CHIP_CSRCS += stm32n6_iwdg.c
endif

ifeq ($(CONFIG_STM32_WWDG),y)
  CHIP_CSRCS += stm32n6_wwdg.c
endif

ifeq ($(CONFIG_STM32_RTC),y)
  CHIP_CSRCS += stm32n6_rtc.c
ifeq ($(CONFIG_RTC_DRIVER),y)
  CHIP_CSRCS += stm32n6_rtc_lowerhalf.c
endif
endif

ifneq ($(filter y,$(CONFIG_STM32_I2C1) $(CONFIG_STM32_I2C2) $(CONFIG_STM32_I2C4)),)
  CHIP_CSRCS += stm32n6_i2c.c
endif

ifeq ($(CONFIG_STM32_EXTI),y)
  CHIP_CSRCS += stm32n6_exti.c
endif

ifeq ($(CONFIG_STM32_TIM2),y)
  CHIP_CSRCS += stm32n6_tim.c
endif

ifeq ($(CONFIG_STM32_TIM5),y)
  CHIP_CSRCS += stm32n6_oneshot.c
endif

ifeq ($(CONFIG_STM32_LPTIM1),y)
  CHIP_CSRCS += stm32n6_lptim.c
endif

ifeq ($(CONFIG_STM32_ADC1),y)
  CHIP_CSRCS += stm32n6_adc.c
endif

ifeq ($(CONFIG_STM32_DTS),y)
  CHIP_CSRCS += stm32n6_dts.c
endif

ifeq ($(CONFIG_STM32_HASH),y)
  CHIP_CSRCS += stm32n6_hash.c
endif

ifeq ($(CONFIG_STM32_DMA2D),y)
  CHIP_CSRCS += stm32n6_dma2d.c
endif

ifeq ($(CONFIG_DEV_GPIO),y)
  CHIP_CSRCS += stm32n6_gpio_lower.c
endif

ifeq ($(CONFIG_STM32_GPDMA),y)
  CHIP_CSRCS += stm32n6_dma.c
endif

ifeq ($(CONFIG_STM32_FSBL_REGRESS),y)
  CHIP_CSRCS += stm32n6_fsbl_regress.c
endif

ifeq ($(CONFIG_STM32_CAM_PROBE),y)
  CHIP_CSRCS += stm32n6_cam_probe.c
endif

ifneq ($(filter y,$(CONFIG_STM32_SPI1) $(CONFIG_STM32_SPI2)),)
  CHIP_CSRCS += stm32n6_spi.c
endif

ifeq ($(CONFIG_STM32_SDMMC1),y)
  CHIP_CSRCS += stm32n6_sdmmc.c
endif

ifneq ($(CONFIG_STM32_XSPI1)$(CONFIG_STM32_XSPI2),)
  CHIP_CSRCS += stm32n6_xspi.c
endif

ifeq ($(CONFIG_STM32_EMAC),y)
  CHIP_CSRCS += stm32n6_ethernet.c
endif

ifeq ($(CONFIG_STM32_SAI1),y)
  CHIP_CSRCS += stm32n6_sai.c
endif

ifeq ($(CONFIG_STM32_FDCAN1),y)
  CHIP_CSRCS += stm32n6_fdcan.c
endif

ifeq ($(CONFIG_STM32_OTG),y)
  CHIP_CSRCS += stm32n6_otg.c
endif

ifeq ($(CONFIG_STM32_RNG),y)
  CHIP_CSRCS += stm32n6_rng.c
endif
